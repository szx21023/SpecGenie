# 使用官方 Nginx 映像
FROM nginx:alpine

# 刪除預設的 Nginx 設定（如果你有自己的 nginx.conf）
RUN rm /etc/nginx/conf.d/default.conf

# 複製你自定義的 nginx.conf 到容器中
COPY default.conf /etc/nginx/conf.d/default.conf

# 複製 dist/ 目錄（前端打包輸出）到 Nginx 的預設網站根目錄
COPY dist/ /usr/share/nginx/html/

# Nginx 預設在 80 port 啟動，不需要 CMD
EXPOSE 80
